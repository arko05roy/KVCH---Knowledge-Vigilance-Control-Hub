{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KVCHAssetServiceProfile",
  "type": "object",
  "required": [
    "asset_id",
    "asset_name",
    "business_service_id",
    "business_service_name",
    "environment",
    "downtime_cost_per_hour_inr",
    "avg_incident_response_cost_inr",
    "rto_hours",
    "active_users"
  ],
  "properties": {
    "asset_id": { "type": "string" },
    "asset_name": { "type": "string" },
    "business_service_id": { "type": "string" },
    "business_service_name": { "type": "string" },
    "environment": { "type": "string", "enum": ["production", "staging", "development"] },
    "downtime_cost_per_hour_inr": { "type": "number", "minimum": 0 },
    "avg_incident_response_cost_inr": { "type": "number", "minimum": 0 },
    "data_breach_cost_per_record_inr": { "type": "number", "minimum": 0 },
    "records_exposed_estimate": { "type": "integer", "minimum": 0 },
    "rto_hours": { "type": "number", "minimum": 0 },
    "active_users": { "type": "integer", "minimum": 0 }
  }
}
