{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KVCHFindingIntake",
  "type": "object",
  "required": [
    "finding_id",
    "source_extension",
    "category",
    "cve_id",
    "asset_id",
    "observed_at",
    "internet_reachable",
    "authentication_required",
    "compensating_controls"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "source_extension": { "type": "string" },
    "category": { "type": "string" },
    "cve_id": { "type": "string" },
    "package_name": { "type": "string" },
    "asset_id": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "internet_reachable": { "type": "boolean" },
    "authentication_required": { "type": "boolean" },
    "compensating_controls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "epss_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "cisa_kev": { "type": "boolean" },
    "cvss_score": { "type": "number", "minimum": 0.0, "maximum": 10.0 }
  }
}
