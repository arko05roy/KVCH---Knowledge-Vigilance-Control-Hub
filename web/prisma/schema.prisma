generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArtifactState {
  uploaded
  evaluating
  deployable
  evaluation_failed
  runtime_unsupported
}

enum EvaluationStatus {
  queued
  running
  passed
  failed
}

enum DeploymentStatus {
  active
  paused
  failed
}

enum RunStatus {
  queued
  running
  healthy
  finding
  failed
}

model Extension {
  id         String     @id @default(cuid())
  companyId  String
  manifestId String
  name       String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  artifacts  Artifact[]

  @@unique([companyId, manifestId])
  @@index([companyId, createdAt])
}

model Artifact {
  id          String        @id @default(cuid())
  extensionId String
  companyId   String
  sha256      String
  storageKey  String
  size        Int
  manifest    Json
  adapterKey  String?
  state       ArtifactState @default(uploaded)
  createdAt   DateTime      @default(now())
  extension   Extension     @relation(fields: [extensionId], references: [id], onDelete: Restrict)
  evaluations Evaluation[]
  deployments Deployment[]
  runs        ScheduledExtensionRun[]
  findings    Finding[]

  @@unique([companyId, sha256])
  @@unique([storageKey])
  @@index([extensionId, createdAt])
}

model Evaluation {
  id             String           @id @default(cuid())
  artifactId     String
  adapterKey     String?
  adapterVersion String?
  status         EvaluationStatus @default(queued)
  startedAt      DateTime?
  finishedAt     DateTime?
  commandResults Json?
  stdout         String?
  stderr         String?
  createdAt      DateTime         @default(now())
  artifact       Artifact         @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@index([artifactId, createdAt])
}

model Deployment {
  id        String           @id @default(cuid())
  artifactId String
  schedule  String
  status    DeploymentStatus @default(active)
  nextRunAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  artifact  Artifact         @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  runs      ScheduledExtensionRun[]

  @@index([artifactId, status])
  @@index([status, nextRunAt])
}

model ScheduledExtensionRun {
  id           String    @id @default(cuid())
  deploymentId String
  artifactId   String
  dueAt        DateTime
  startedAt    DateTime?
  finishedAt   DateTime?
  status       RunStatus @default(queued)
  exitCode     Int?
  commandResults Json?
  stdout       String?
  stderr       String?
  createdAt    DateTime  @default(now())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  artifact     Artifact   @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  findings     Finding[]

  @@unique([deploymentId, dueAt])
  @@index([artifactId, createdAt])
}

model Finding {
  id         String                @id @default(cuid())
  runId      String
  artifactId String
  envelope   Json
  severity   String
  category   String
  title      String
  observedAt DateTime
  createdAt  DateTime              @default(now())
  run        ScheduledExtensionRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  artifact   Artifact              @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  aiReport   AIReport?

  @@index([artifactId, observedAt])
  @@index([runId])
}

// ---------------------------------------------------------------------------
// ZK subsystem — ZK-owned state only; never references upstream tables.
// ---------------------------------------------------------------------------

enum ZkJobStatus {
  queued
  proving
  verifying
  attestating
  publishing
  submitted
  anchored
  failed
  cancelled
}

enum ZkClaimStatus {
  pending
  anchored
  revoked
  superseded
  invalidated
  expired
}

enum ZkArtifactStatus {
  active
  paused
  deprecated
  invalidated
}

enum ZkDisputeStatus {
  open
  resolved
  appealed
}

model ZkInputBundle {
  id             String   @id @default(cuid())
  companyId      String
  adapterKey     String
  adapterVersion String
  envelopeDigest String
  envelopeRef    String
  schemaVersion  String
  createdAt      DateTime @default(now())
  proofJobs      ZkProofJob[]

  @@unique([companyId, envelopeDigest])
  @@index([companyId, createdAt])
}

model ZkEvidenceSnapshot {
  id                   String   @id @default(cuid())
  companyId            String
  snapshotDigest       String
  merkleRoot           String
  leafCount            Int
  selectionPolicyCode  Int
  normalizationCode    Int
  createdAt            DateTime @default(now())

  @@unique([companyId, snapshotDigest])
}

model ZkCircuitVersion {
  id             String           @id @default(cuid())
  circuitId      String           @unique
  name           String
  artifactDigest String
  vkDigest       String
  proofFlavor    String
  status         ZkArtifactStatus @default(active)
  registeredAt   DateTime?
  createdAt      DateTime         @default(now())
  proofJobs      ZkProofJob[]

  @@index([status])
}

model ZkPolicyVersion {
  id              String           @id @default(cuid())
  policyId        String           @unique
  policyDigest    String
  codebookDigest  String
  sourceDigest    String?
  auditDigest     String?
  containerDigest String?
  status          ZkArtifactStatus @default(active)
  createdAt       DateTime         @default(now())
  proofJobs       ZkProofJob[]
}

model ZkProofJob {
  id                 String       @id @default(cuid())
  companyId          String
  claimKind          String // threat | risk | endorsement | inclusion
  idempotencyKey     String       @unique
  status             ZkJobStatus  @default(queued)
  inputBundleId      String
  circuitVersionId   String
  policyVersionId    String
  expectedDigest     String?
  bundleDigest       String?
  errorCode          String?
  errorDetail        String?
  attemptCount       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  finishedAt         DateTime?
  inputBundle        ZkInputBundle   @relation(fields: [inputBundleId], references: [id], onDelete: Restrict)
  circuitVersion     ZkCircuitVersion @relation(fields: [circuitVersionId], references: [id], onDelete: Restrict)
  policyVersion      ZkPolicyVersion  @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  bundle             ZkProofBundle?
  attestations       ZkVerifierAttestation[]
  claim              ZkClaim?
  endorsement        ZkEndorsement?

  @@index([companyId, status, createdAt])
}

model ZkProofBundle {
  id          String   @id @default(cuid())
  jobId       String   @unique
  bundleDigest String  @unique
  refDigest   String
  body        Json
  byteSize    Int
  createdAt   DateTime @default(now())
  job         ZkProofJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
}

model ZkVerifierAttestation {
  id        String   @id @default(cuid())
  jobId     String
  claimId   String
  verifier  String
  decision  Int
  reasonCode Int
  nonce     String
  issuedAt  BigInt
  deadline  BigInt
  signature String
  digest    String
  createdAt DateTime @default(now())
  job       ZkProofJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, verifier])
  @@index([claimId])
}

enum ZkChainStatus {
  pending
  confirmed
}

model ZkClaim {
  id                  String        @id @default(cuid())
  claimId             String        @unique
  jobId               String        @unique
  companyId           String
  claimSeriesId       String
  claimVersion        Int
  issuerCompanyCode   BigInt
  status              ZkClaimStatus @default(pending)
  chainStatus         ZkChainStatus @default(pending)
  bundleDigest        String
  publicInputDigest   String
  disclosureNullifier String
  councilSetId        BigInt
  expiryEpoch         BigInt
  txHash              String?
  blockNumber         BigInt?
  anchoredAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  job                 ZkProofJob    @relation(fields: [jobId], references: [id], onDelete: Restrict)
  endorsements        ZkEndorsement[]
  disputes            ZkDispute[]

  @@index([companyId, status])
  @@index([status])
}

model ZkEndorsement {
  id                   String   @id @default(cuid())
  endorsementId        String   @unique
  jobId                String   @unique
  targetClaimId        String
  endorserCompanyCode  BigInt
  endorsementNullifier String
  matchBandCode        Int
  bundleDigest         String
  txHash               String?
  chainStatus          ZkChainStatus @default(pending)
  createdAt            DateTime @default(now())
  job                  ZkProofJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  targetClaim          ZkClaim    @relation(fields: [targetClaimId], references: [claimId], onDelete: Restrict)

  @@unique([targetClaimId, endorserCompanyCode])
  @@index([targetClaimId])
}

model ZkDispute {
  id               String          @id @default(cuid())
  claimId          String
  status           ZkDisputeStatus @default(open)
  reasonCode       Int
  evidenceDigest   String
  resolutionDigest String?
  resolutionCode   Int?
  appealRef        String?
  txHash           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  claim            ZkClaim         @relation(fields: [claimId], references: [claimId], onDelete: Restrict)

  @@index([claimId, status])
}

model ZkChainEvent {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  eventName       String
  txHash          String
  logIndex        Int
  blockNumber     BigInt
  blockHash       String
  payload         Json
  processedAt     DateTime @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, blockNumber])
}

model ZkIndexerCursor {
  id            String  @id @default("celo")
  chainId       Int
  lastBlock     BigInt  @default(0)
  updatedAt     DateTime @updatedAt
}

enum ZkJoinKind {
  verifier
  company
}

enum ZkJoinStatus {
  pending
  approved
  rejected
}

/// Self-service onboarding requests — a verifier's seat request lands here
/// until governance includes their key in a newly registered council set;
/// a company's registration records its identity and first-use intent.
model ZkJoinRequest {
  id            String       @id @default(cuid())
  kind          ZkJoinKind
  status        ZkJoinStatus @default(pending)
  walletAddress String?
  companyCode   String?
  label         String?
  note          String?
  chainId       Int?
  councilSetId  BigInt?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  resolvedAt    DateTime?

  @@index([kind, status])
  @@index([walletAddress])
}
